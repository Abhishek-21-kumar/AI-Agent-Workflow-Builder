# Nhost Configuration
# Set these to your Nhost project subdomain and region (or local backend values for local dev)
NHOST_SUBDOMAIN=local
NHOST_REGION=local

# Public environment variables for Next.js frontend
NEXT_PUBLIC_NHOST_SUBDOMAIN=local
NEXT_PUBLIC_NHOST_REGION=local

# Hasura Admin API (used by execution engine for server-side data access)
NHOST_GRAPHQL_URL=http://localhost:8080/v1/graphql
NHOST_ADMIN_SECRET=nhost-admin-secret

# Hasura Action Base URL (where Next.js API routes are served)
ACTION_BASE_URL=http://localhost:3000

# LLM API Configuration (Groq / Gemini / OpenRouter)
# When not set, the execution engine uses a deterministic development stub.
LLM_API_KEY=your_llm_api_key_here
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
